  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Toner-black primary action, e.g. Új határidő.",
      "html": "<button class=\"ds-btn-primary\">Új határidő</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;height:40px;padding:0 16px;border-radius:var(--radius);background:var(--accent);border:1px solid var(--accent);color:var(--accent-ink);font:600 14.5px/1 var(--font-archivo,Archivo,sans-serif);box-shadow:0 1px 2px rgba(20,24,28,0.25);cursor:pointer;transition:background-color .15s var(--ease-out),transform .15s var(--ease-out)}.ds-btn-primary:hover{background:#33363a}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A paper-slip button for secondary actions.",
      "html": "<button class=\"ds-btn-secondary\">Mégse</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;height:40px;padding:0 16px;border-radius:var(--radius);background:var(--panel);border:1px solid var(--border);color:var(--fg);font:500 14.5px/1 var(--font-archivo,Archivo,sans-serif);box-shadow:0 1px 1px rgba(30,40,48,0.06);cursor:pointer;transition:border-color .15s,box-shadow .15s,transform .15s}.ds-btn-secondary:hover{border-color:var(--border-strong);box-shadow:var(--shadow-paper)}.ds-btn-secondary:active{transform:translateY(1px)}.ds-btn-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive action in the red pin's ink.",
      "html": "<button class=\"ds-btn-danger\">Törlés</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;height:40px;padding:0 16px;border-radius:var(--radius);background:var(--danger);border:1px solid var(--danger);color:var(--accent-ink);font:600 14.5px/1 var(--font-archivo,Archivo,sans-serif);cursor:pointer;transition:background-color .15s}.ds-btn-danger:hover{background:#9a1f18}.ds-btn-danger:focus-visible{outline:2px solid var(--danger);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Copy-paper field with a toner focus outline and a red caret.",
      "html": "<input class=\"ds-input\" placeholder=\"Határidő címe\">",
      "css": ".ds-input{width:100%;max-width:320px;padding:8px 12px;border-radius:var(--radius);border:1px solid var(--border);background:var(--panel);color:var(--fg);font:400 14.5px/1.4 var(--font-archivo,Archivo,sans-serif);box-shadow:inset 0 1px 2px rgba(30,40,48,0.06);caret-color:var(--pin);transition:border-color .15s}.ds-input::placeholder{color:var(--muted-dim)}.ds-input:hover{border-color:var(--border-strong)}.ds-input:focus-visible{border-color:var(--accent);outline:2px solid var(--accent);outline-offset:0}"
    },
    {
      "name": "Filter Pill",
      "kind": "chip",
      "refersTo": "pill",
      "description": "Round toggle; active is toner.",
      "html": "<button class=\"ds-pill\">Mind</button> <button class=\"ds-pill ds-pill-active\">Kritikus</button>",
      "css": ".ds-pill{display:inline-flex;align-items:center;height:32px;padding:0 12px;border-radius:9999px;border:1px solid var(--border);background:var(--panel);color:var(--muted);font:500 13px/1 var(--font-archivo,Archivo,sans-serif);cursor:pointer;transition:color .15s,border-color .15s}.ds-pill:hover{border-color:var(--border-strong);color:var(--heading)}.ds-pill-active{border-color:var(--accent);background:var(--accent);color:var(--accent-ink)}.ds-pill-active:hover{background:#33363a;color:var(--accent-ink)}.ds-pill:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "",
      "description": "Top-bar links on felt; the active route is a paper tab.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-link ds-nav-active\" href=\"#\">Hét</a><a class=\"ds-nav-link\" href=\"#\">Határidők</a><a class=\"ds-nav-link\" href=\"#\">Beállítások</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px;padding:12px;background:var(--bg)}.ds-nav-link{display:inline-flex;align-items:center;height:36px;padding:0 12px;border-radius:var(--radius);color:var(--muted);font:600 14.5px/1 var(--font-archivo,Archivo,sans-serif);text-decoration:none;transition:background-color .15s,color .15s}.ds-nav-link:hover{background:rgba(253,253,250,0.6);color:var(--heading)}.ds-nav-active{background:var(--panel);color:var(--heading);box-shadow:var(--shadow-paper)}.ds-nav-link:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Paper Sheet",
      "kind": "card",
      "refersTo": "card",
      "description": "A sheet of copy paper on the felt.",
      "html": "<div class=\"ds-felt\"><div class=\"ds-card\"><h2 class=\"ds-h2\">Tárgyak</h2><p class=\"ds-sub\">Linkek és határidők tárgyanként.</p></div></div>",
      "css": ".ds-felt{background:var(--bg);padding:24px}.ds-card{background:var(--panel);border-radius:var(--radius-slip);box-shadow:var(--shadow-sheet);padding:24px;transition:box-shadow .2s}.ds-card:hover{box-shadow:var(--shadow-lift)}.ds-h2{margin:0;font-family:var(--font-archivo,Archivo,sans-serif);font-stretch:72%;font-weight:800;font-size:28px;line-height:1.02;color:var(--heading)}.ds-sub{margin:8px 0 0;font-size:15px;color:var(--muted)}"
    },
    {
      "name": "Deadline Slip",
      "kind": "custom",
      "refersTo": "deadline-slip",
      "description": "A pinned deadline slip; the pin carries state, done slips unpin and tilt.",
      "html": "<div class=\"ds-felt2\"><div class=\"ds-slip\"><span class=\"ds-pin\" style=\"--pin-color:#2b5b84\"></span><label class=\"ds-slip-row\"><input type=\"checkbox\" class=\"ds-check\"><span><span class=\"ds-slip-title\">Beadandó 02</span><span class=\"ds-slip-meta\">23:59 · Analízis I.</span></span></label><span class=\"ds-bar\" style=\"width:40%\"></span></div><div class=\"ds-slip ds-overdue\"><span class=\"ds-pin\"></span><label class=\"ds-slip-row\"><input type=\"checkbox\" class=\"ds-check\"><span><span class=\"ds-slip-title\">Labor jegyzőkönyv</span><span class=\"ds-slip-meta ds-late\">okt. 2. 12:00</span></span></label></div><div class=\"ds-slip ds-done\"><span class=\"ds-pin\"></span><label class=\"ds-slip-row\"><input type=\"checkbox\" class=\"ds-check\" checked><span><span class=\"ds-slip-title\" style=\"color:var(--muted)\">ZH felkészülés</span><span class=\"ds-slip-meta\">10:00</span></span></label></div></div>",
      "css": ".ds-felt2{display:flex;flex-direction:column;gap:12px;width:220px;padding:16px 10px;background:var(--strip);border-radius:var(--radius-slip)}.ds-slip{position:relative;background:var(--panel);border-radius:var(--radius-slip);box-shadow:var(--shadow-paper);padding:12px 10px 10px;transform-origin:85% 0;transition:transform .4s var(--ease-out-expo),box-shadow .2s,opacity .3s}.ds-slip:hover{box-shadow:var(--shadow-lift)}.ds-overdue{background:var(--salmon)}.ds-done{transform:rotate(-2.2deg) translateY(2px);opacity:.72;box-shadow:0 1px 2px rgba(30,40,48,0.12)}.ds-pin{--pin-color:var(--pin);position:absolute;top:-4px;left:11px;width:11px;height:11px;border-radius:9999px;background:var(--pin-color);box-shadow:1px 2px 2px rgba(20,24,28,0.35);transition:transform .28s var(--ease-out-expo),opacity .2s}.ds-done .ds-pin{transform:translateY(-6px) scale(0);opacity:0}.ds-slip-row{display:flex;gap:8px;align-items:flex-start;cursor:pointer}.ds-check{margin-top:3px;width:15px;height:15px;accent-color:var(--accent)}.ds-slip-title{display:block;font:600 13.5px/1.375 var(--font-archivo,Archivo,sans-serif);color:var(--heading)}.ds-done .ds-slip-title{text-decoration:line-through}.ds-slip-meta{display:block;margin-top:4px;font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}.ds-late{color:var(--danger);font-weight:600}.ds-bar{position:absolute;bottom:0;left:0;height:2px;border-radius:0 9999px 9999px 0;background:rgba(17,18,20,0.2)}"
    },
    {
      "name": "Class Chip",
      "kind": "chip",
      "refersTo": "class-chip",
      "description": "A class taped flat on sky paper: no pin, no checkbox, no shadow.",
      "html": "<div class=\"ds-class\"><span class=\"ds-dot\"></span><div><p class=\"ds-class-time\">10:15–11:45 <span class=\"ds-room\">QBF13</span></p><p class=\"ds-class-name\">Analízis I.</p></div></div>",
      "css": ".ds-class{display:flex;gap:6px;align-items:flex-start;max-width:220px;padding:6px 8px;border-radius:var(--radius-slip);background:color-mix(in srgb,var(--sky) 80%,transparent);font:400 12px/1.375 var(--font-archivo,Archivo,sans-serif);color:var(--muted)}.ds-dot{margin-top:5px;width:6px;height:6px;border-radius:9999px;background:var(--accent-2);flex-shrink:0}.ds-class p{margin:0}.ds-class-time{font-weight:600;color:var(--heading);font-variant-numeric:tabular-nums}.ds-room{font-weight:400;color:var(--muted)}"
    }
  ],
  "narrative": {
    "northStar": "The Corridor Notice Board, Made Calm",
    "overview": "The app is the faculty corridor notice board with the noise taken out. A cool grey-blue felt ground carries white copy-paper sheets and slips; every deadline is a slip hung from a round pushpin, and the pin is the state. Coloured copy paper does the rest of the signalling: canary for today, salmon for overdue, sky for classes. Type is black toner. Headings are set like a printed notice, in heavy condensed Archivo; everything else is normal-width Archivo at working size.\n\nTime is the spine. The week board runs Monday to Sunday as seven lighter felt strips, with an overdue gutter on salmon paper at the left when something is late. Density is moderate: one board, one \"Következő\" notice that owns focus, one sheet for the course list. Behind every page a canvas draws faint ghost slips in the colours of the student's real open deadlines, swaying in a corridor draught; one falls off every few seconds and another is pinned up elsewhere.\n\nThe world is light only and flat in colour. It rejects the dark dashboard with neon accents it replaced, and the generic white SaaS calendar. Depth comes from paper physically sitting on felt (soft, short, cool-tinted shadows), never from gradients, glows or glass.",
